<!DOCTYPE html>
<html lang="tr" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Daily Hub — Kişisel Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], display: ['Space Grotesk', 'sans-serif'] },
                    colors: {
                        dark: { bg: '#0a0a0f', surface: '#111118', card: '#16161f', border: '#1e1e2e' },
                        neon: { blue: '#4f8ef7', purple: '#a78bfa', cyan: '#22d3ee', green: '#34d399', pink: '#f472b6', amber: '#fbbf24' }
                    }
                }
            }
        }
    </script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; overflow: hidden; }
        body { font-family: 'Inter', sans-serif; background: #0a0a0f; display: flex; flex-direction: column; }
        .font-display { font-family: 'Space Grotesk', sans-serif; }

        /* ── SCROLLBAR ── */
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #2a2a3e; border-radius: 4px; }

        /* ── SIDEBAR ── */
        #sidebar {
            width: 240px; min-width: 240px;
            background: #0d0d15; border-right: 1px solid #1e1e2e;
            display: flex; flex-direction: column;
            transition: width .25s cubic-bezier(.4,0,.2,1), min-width .25s cubic-bezier(.4,0,.2,1);
            overflow: hidden; position: relative; z-index: 40;
        }
        #sidebar.collapsed { width: 60px; min-width: 60px; }

        .sidebar-logo {
            height: 60px; display: flex; align-items: center; gap: 12px;
            padding: 0 16px; border-bottom: 1px solid #1e1e2e; flex-shrink: 0;
            overflow: hidden; white-space: nowrap;
        }
        .sidebar-logo-icon {
            width: 32px; min-width: 32px; height: 32px; border-radius: 9px;
            background: linear-gradient(135deg,#4f8ef7,#a78bfa);
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }
        .sidebar-logo-text { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 15px; color: #f1f5f9; transition: opacity .2s; }
        #sidebar.collapsed .sidebar-logo-text { opacity: 0; pointer-events: none; }

        .sidebar-nav { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 10px 8px; }
        .nav-section-title {
            font-size: 10px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
            color: #374151; padding: 10px 10px 4px; white-space: nowrap; transition: opacity .2s;
        }
        #sidebar.collapsed .nav-section-title { opacity: 0; }
        .nav-item {
            display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 10px;
            cursor: pointer; transition: background .15s; white-space: nowrap; overflow: hidden;
            position: relative; text-decoration: none;
        }
        .nav-item:hover { background: #1a1a28; }
        .nav-item.active { background: #1c1c30; }
        .nav-item .nav-icon {
            width: 32px; min-width: 32px; height: 32px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center; font-size: 16px;
            flex-shrink: 0; background: #111118; transition: background .15s;
        }
        .nav-item.active .nav-icon { background: #1e1e3a; }
        .nav-item:hover .nav-icon { background: #1a1a2a; }
        .nav-label { font-size: 13px; font-weight: 500; color: #94a3b8; transition: color .15s, opacity .2s; }
        .nav-item.active .nav-label { color: #f1f5f9; }
        .nav-item:hover .nav-label { color: #e2e8f0; }
        #sidebar.collapsed .nav-label { opacity: 0; }

        .nav-item.active::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 3px; height: 20px; border-radius: 0 3px 3px 0; }
        .nav-item[data-widget="weather"].active::before { background: #22d3ee; }
        .nav-item[data-widget="currency"].active::before { background: #34d399; }
        .nav-item[data-widget="crypto"].active::before { background: #a78bfa; }
        .nav-item[data-widget="fuel"].active::before { background: #fbbf24; }
        .nav-item[data-widget="football"].active::before { background: #4f8ef7; }
        .nav-item[data-widget="movie"].active::before { background: #f472b6; }
        .nav-item[data-widget="music"].active::before { background: #a78bfa; }
        .nav-item[data-widget="news"].active::before { background: #f87171; }
        .nav-item[data-widget="recipe"].active::before { background: #fbbf24; }
        .nav-item[data-widget="quote"].active::before { background: #a78bfa; }

        #sidebar.collapsed .nav-item:hover::after {
            content: attr(data-tip); position: absolute; left: 62px; top: 50%; transform: translateY(-50%);
            background: #1e1e2e; color: #f1f5f9; font-size: 12px; font-weight: 500; padding: 5px 10px;
            border-radius: 7px; white-space: nowrap; border: 1px solid #2a2a3e; z-index: 999; pointer-events: none;
        }

        .sidebar-bottom { padding: 10px 8px 14px; border-top: 1px solid #1e1e2e; flex-shrink: 0; }

        /* ── NAVBAR ── */
        #navbar {
            height: 60px; flex-shrink: 0; background: rgba(13,13,21,.92); border-bottom: 1px solid #1e1e2e;
            backdrop-filter: blur(16px); display: flex; align-items: center; justify-content: space-between;
            padding: 0 20px; gap: 16px; position: relative; z-index: 50;
        }

        .search-wrap {
            flex: 1; max-width: 360px; display: flex; align-items: center; gap: 8px;
            background: #111118; border: 1px solid #1e1e2e; border-radius: 10px; padding: 0 12px;
            height: 36px; transition: border-color .15s;
        }
        .search-wrap:focus-within { border-color: #4f8ef7; }
        .search-wrap input { flex: 1; background: none; border: none; outline: none; font-size: 13px; color: #f1f5f9; font-family: 'Inter', sans-serif; }
        .search-wrap input::placeholder { color: #4b5563; }

        .nb-pill {
            display: flex; align-items: center; gap: 6px; background: #111118; border: 1px solid #1e1e2e;
            border-radius: 10px; padding: 0 12px; height: 36px; cursor: pointer; font-size: 13px; color: #94a3b8;
            transition: background .15s, border-color .15s; white-space: nowrap;
        }
        .nb-pill:hover { background: #1a1a28; border-color: #2a2a3e; color: #f1f5f9; }
        .nb-pill .dot { width: 7px; height: 7px; border-radius: 50%; background: #34d399; }
        .nb-pill .dot.pulse { animation: pulse 2s infinite; }
        @@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

        .avatar {
            width: 34px; height: 34px; border-radius: 50%; cursor: pointer; flex-shrink: 0;
            background: linear-gradient(135deg,#a78bfa,#4f8ef7); display: flex; align-items: center;
            justify-content: center; font-size: 13px; font-weight: 700; color: white; border: 2px solid #1e1e2e;
            transition: border-color .15s;
        }
        .avatar:hover { border-color: #4f8ef7; }

        .nb-badge { position: relative; }
        .nb-badge::after {
            content: '3'; position: absolute; top: -5px; right: -5px; width: 16px; height: 16px;
            border-radius: 50%; background: #f87171; color: white; font-size: 9px; font-weight: 700;
            display: flex; align-items: center; justify-content: center;
        }

        /* ── LAYOUT SHELL ── */
        #app { display: flex; flex: 1; overflow: hidden; }
        #content-area { flex: 1; overflow-y: auto; display: flex; flex-direction: column; }
        #page-header { padding: 20px 24px 0; flex-shrink: 0; }

        /* ── CARDS ── */
        .card {
            background: #16161f; border: 1px solid #1e1e2e; border-radius: 16px; padding: 20px;
            transition: border-color .2s, transform .2s, opacity .3s; animation: fadeUp .4s ease forwards; opacity: 1;
        }
        .card:hover { border-color: #2e2e4a; transform: translateY(-2px); }
        .card.hidden-card { display: none; }
        @@keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

        .acc-blue { border-top: 2px solid #4f8ef7; } .acc-purple { border-top: 2px solid #a78bfa; }
        .acc-cyan { border-top: 2px solid #22d3ee; } .acc-green { border-top: 2px solid #34d399; }
        .acc-pink { border-top: 2px solid #f472b6; } .acc-amber { border-top: 2px solid #fbbf24; }
        .acc-red { border-top: 2px solid #f87171; }

        .badge { display: inline-flex; align-items: center; gap: 3px; padding: 2px 99px; border-radius: 999px; font-size: 11px; font-weight: 500; }
        .pbar { height: 3px; border-radius: 999px; background: #1e1e2e; overflow: hidden; }
        .pfill { height: 100%; border-radius: 999px; }
        .scorebox { background: #0a0a0f; border: 1px solid #1e1e2e; border-radius: 12px; padding: 10px 20px; }
        .mbar { height: 4px; border-radius: 999px; background: #1e1e2e; position: relative; cursor: pointer; }
        .mfill { height: 100%; width: 38%; border-radius: 999px; background: linear-gradient(90deg,#a78bfa,#4f8ef7); }
        .mdot { width: 10px; height: 10px; border-radius: 50%; background: #fff; position: absolute; top: 50%; transform: translateY(-50%); left: 36%; box-shadow: 0 0 6px rgba(167,139,250,.7); }
        .inset { background: #0a0a0f; border: 1px solid #1e1e2e; }
        .sep { background: #1e1e2e; }

        .tog { width: 44px; height: 24px; border-radius: 12px; background: #1e1e2e; position: relative; cursor: pointer; transition: background .2s; flex-shrink: 0; }
        .tog-k { width: 18px; height: 18px; border-radius: 50%; background: #4f8ef7; position: absolute; top: 3px; left: 3px; transition: transform .2s; }
        html.light .tog-k { transform: translateX(20px); background: #fbbf24; }

        .widget-tog { width: 34px; height: 18px; border-radius: 9px; background: #1e1e2e; position: relative; cursor: pointer; transition: background .2s; flex-shrink: 0; }
        .widget-tog.on { background: #4f8ef7; }
        .widget-tog::after { content: ''; width: 14px; height: 14px; border-radius: 50%; background: #fff; position: absolute; top: 2px; left: 2px; transition: transform .2s; }
        .widget-tog.on::after { transform: translateX(16px); }

        /* ── LIGHT MODE ── */
        html.light body { background: #f0f4ff; }
        html.light #sidebar { background: #fafbff; border-color: #e2e8f0; }
        html.light #navbar { background: rgba(250,251,255,.92); border-color: #e2e8f0; }
        html.light .nav-item:hover { background: #f0f4ff; }
        html.light .nav-item.active { background: #eff0ff; }
        html.light .nav-label { color: #64748b; }
        html.light .nav-item.active .nav-label { color: #1e293b; }
        html.light .nav-item .nav-icon { background: #f0f4ff; }
        html.light .nav-item.active .nav-icon { background: #e8eaff; }
        html.light .card { background: #fff; border-color: #e2e8f0; }
        html.light .card:hover { border-color: #c7d2fe; }
        html.light .search-wrap { background: #f0f4ff; border-color: #e2e8f0; }
        html.light .search-wrap input { color: #1e293b; }
        html.light .search-wrap input::placeholder { color: #9ca3af; }
        html.light .nb-pill { background: #f0f4ff; border-color: #e2e8f0; color: #64748b; }
        html.light .nb-pill:hover { background: #e8eaff; color: #1e293b; }
        html.light .scorebox { background: #f8fafc; border-color: #e2e8f0; }
        html.light .pbar, html.light .mbar { background: #e2e8f0; }
        html.light .inset { background: #f8fafc!important; border-color: #e2e8f0!important; }
        html.light .sep { background: #e2e8f0!important; }
        html.light .lbl { color: #64748b!important; }
        html.light .val { color: #0f172a!important; }
        html.light .ttl { color: #1e293b!important; }
        html.light .sub { color: #64748b!important; }
        html.light .nav-section-title { color: #9ca3af; }
        html.light .sidebar-bottom { border-color: #e2e8f0; }
        html.light .sidebar-logo { border-color: #e2e8f0; }
        html.light #sidebar.collapsed .nav-item:hover::after { background: #1e293b; color: #f1f5f9; border-color: #e2e8f0; }
        html.light .widget-tog { background: #cbd5e1; }
        html.light .quote-card { background: linear-gradient(135deg,#f0eeff,#ede8ff)!important; border-color: #c4b5fd!important; }
    </style>
</head>
<body>

    <nav id="navbar">
        <div class="flex items-center gap-3 flex-shrink-0">
            <button id="sidebar-toggle"
                    style="width:36px;height:36px;border-radius:9px;background:#111118;border:1px solid #1e1e2e;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .15s;flex-shrink:0;"
                    onmouseover="this.style.background='#1a1a28'" onmouseout="this.style.background='#111118'">
                <svg id="hamburger-icon" width="16" height="16" fill="none" stroke="#94a3b8" stroke-width="1.8" stroke-linecap="round">
                    <line x1="2" y1="4" x2="14" y2="4" />
                    <line x1="2" y1="8" x2="14" y2="8" />
                    <line x1="2" y1="12" x2="14" y2="12" />
                </svg>
            </button>
            <div class="hidden sm:flex items-center gap-2">
                <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#4f8ef7,#a78bfa);display:flex;align-items:center;justify-content:center;">
                    <svg width="14" height="14" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round">
                        <rect x="2" y="2" width="4.5" height="4.5" rx="1" />
                        <rect x="8.5" y="2" width="4.5" height="4.5" rx="1" />
                        <rect x="2" y="8.5" width="4.5" height="4.5" rx="1" />
                        <rect x="8.5" y="8.5" width="4.5" height="4.5" rx="1" />
                    </svg>
                </div>
                <span class="font-display font-bold text-sm" style="color:#f1f5f9;">Daily Hub</span>
            </div>
        </div>

        <div class="search-wrap">
            <svg width="14" height="14" fill="none" stroke="#4b5563" stroke-width="1.8" stroke-linecap="round"><circle cx="6" cy="6" r="4.5" /><line x1="9.5" y1="9.5" x2="13" y2="13" /></svg>
            <input type="text" placeholder="Widget ara veya komut gir..." id="search-input" />
            <span style="font-size:11px;color:#374151;border:1px solid #1e1e2e;border-radius:5px;padding:1px 6px;">⌘K</span>
        </div>

        <div class="flex items-center gap-2 flex-shrink-0">
            <div class="nb-pill hidden sm:flex">
                <div class="dot pulse"></div>
                <span id="nav-clock">--:--</span>
            </div>
            <button class="nb-pill" onclick="refreshAll()" title="Verileri yenile">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M1 4a6 6 0 0 1 10.5-1M13 8A6 6 0 0 1 2.5 9" /><polyline points="1 1 1 4 4 4" /><polyline points="13 11 13 8 10 8" /></svg>
                <span class="hidden md:inline">Yenile</span>
            </button>
            <button class="nb-pill nb-badge" title="Bildirimler">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 1a4 4 0 0 1 4 4c0 3 1.5 4 1.5 4H.5S2 8 2 5a4 4 0 0 1 4-4zM4.5 9a1.5 1.5 0 0 0 3 0" /></svg>
            </button>
            <div class="tog" onclick="toggleTheme()"><div class="tog-k"></div></div>
            <div class="avatar" title="Profil">Aİ</div>
        </div>
    </nav>

    <div id="app">
        <aside id="sidebar">
            <div class="sidebar-logo">
                <div class="sidebar-logo-icon">
                    <svg width="16" height="16" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round">
                        <rect x="2" y="2" width="5" height="5" rx="1.2" />
                        <rect x="11" y="2" width="5" height="5" rx="1.2" />
                        <rect x="2" y="11" width="5" height="5" rx="1.2" />
                        <rect x="11" y="11" width="5" height="5" rx="1.2" />
                    </svg>
                </div>
                <span class="sidebar-logo-text">Kişisel Panel</span>
            </div>

            <div class="sidebar-nav">
                <p class="nav-section-title">Genel</p>
                <a class="nav-item active" data-widget="all" data-tip="Tüm Widget'lar" href="/Home/Index">
                    <div class="nav-icon" style="font-size:15px;">⊞</div>
                    <span class="nav-label">Tüm Widget'lar</span>
                </a>

                <p class="nav-section-title" style="margin-top:6px;">Veriler</p>

                <a class="nav-item" data-widget="weather" data-tip="Hava Durumu" href="/Weather/Index">
                    <div class="nav-icon">🌤</div>
                    <span class="nav-label">Hava Durumu</span>
                </a>
                <a class="nav-item" data-widget="currency" data-tip="Döviz Kurları" href="/Currency/Index">
                    <div class="nav-icon">💱</div>
                    <span class="nav-label">Döviz Kurları</span>
                </a>
                <a class="nav-item" data-widget="crypto" data-tip="Kripto Para" href="/Crypto/Index">
                    <div class="nav-icon">🪙</div>
                    <span class="nav-label">Kripto Para</span>
                </a>
                <a class="nav-item" data-widget="fuel" data-tip="Akaryakıt" href="/Fuel/Index">
                    <div class="nav-icon">⛽</div>
                    <span class="nav-label">Akaryakıt</span>
                </a>
                <a class="nav-item" data-widget="football" data-tip="Futbol Maçı" href="/FootballMatch/Index">
                    <div class="nav-icon">⚽</div>
                    <span class="nav-label">Futbol Maçı</span>
                </a>

                <p class="nav-section-title" style="margin-top:6px;">Medya</p>

                <a class="nav-item" data-widget="movie" data-tip="Günün Filmi" href="/Movie/Index">
                    <div class="nav-icon">🎬</div>
                    <span class="nav-label">Günün Filmi</span>
                </a>
                <a class="nav-item" data-widget="music" data-tip="Günün Şarkısı" href="/Music/Index">
                    <div class="nav-icon">🎵</div>
                    <span class="nav-label">Günün Şarkısı</span>
                </a>
                <a class="nav-item" data-widget="news" data-tip="Haberler" href="/News/Index">
                    <div class="nav-icon">📰</div>
                    <span class="nav-label">Haberler</span>
                </a>
                <a class="nav-item" data-widget="recipe" data-tip="Yemek Önerisi" href="/Recipe/Index">
                    <div class="nav-icon">🍝</div>
                    <span class="nav-label">Yemek Önerisi</span>
                </a>
                <a class="nav-item" data-widget="quote" data-tip="Motivasyon Sözü" href="/Quote/Index">
                    <div class="nav-icon">💬</div>
                    <span class="nav-label">Motivasyon Sözü</span>
                </a>
            </div>

            <div class="sidebar-bottom">
                <div class="nav-item" style="gap:10px;">
                    <div class="nav-icon" style="font-size:15px;">AY</div>
                    <div style="overflow:hidden;flex:1;">
                        <p class="nav-label" style="font-size:12px;color:#f1f5f9;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Ayşe Nur EROL İREÇ</p>
                        <p style="font-size:11px;color:#4b5563;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Pro Plan</p>
                    </div>
                </div>
            </div>
        </aside>

        <div id="content-area">
            @RenderBody()
        </div>
    </div>

    <script>
        // ─── CLOCK ─────────────────────────────────────────────────────────
        function tick() {
            const n = new Date();
            const el = document.getElementById('nav-clock');
            if (el) el.textContent = n.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
        }
        tick(); setInterval(tick, 30000);

        // ─── THEME ─────────────────────────────────────────────────────────
        function toggleTheme() {
            document.documentElement.classList.toggle('dark');
            document.documentElement.classList.toggle('light');
        }

        // ─── SIDEBAR TOGGLE ────────────────────────────────────────────────
        const sidebar = document.getElementById('sidebar');
        document.getElementById('sidebar-toggle').addEventListener('click', () => {
            sidebar.classList.toggle('collapsed');
        });
    </script>
</body>
</html>